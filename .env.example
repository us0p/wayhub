# Copy to `.env` (git-ignored) and replace every <...> value. Never commit `.env`.
APP_ENV=dev

# Local Postgres (docker compose). Use a generated password, e.g.: openssl rand -hex 24
POSTGRES_USER=mentor
POSTGRES_PASSWORD=<generate-a-password>
POSTGRES_DB=mentor

# Used when running the app/tests on the host against the compose database
# (inside compose, DATABASE_URL is built from the POSTGRES_* values above).
DATABASE_URL=postgresql+asyncpg://mentor:<same-password>@localhost:5432/mentor

# At least 32 characters, e.g.: openssl rand -hex 32
SECRET_KEY=<generate-a-secret>

# Google login (D41). Optional in dev: without it, use /auth/dev-login (D42).
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data-controller contact shown in the privacy policy (required in prod).
PRIVACY_CONTACT_EMAIL=

# AI providers (D45, D46). `fake` = deterministic offline adapters (dev/test only; refused in prod).
# Real providers: AI_LLM=gemini AI_EMBEDDER=gemini AI_STT=google AI_TTS=google
AI_LLM=fake
AI_EMBEDDER=fake
AI_STT=fake
AI_TTS=fake

# Gemini: `api_key` (Google AI Studio key from a project with billing enabled; the free tier
# lets Google use the data for training, which our privacy policy does not allow) or `vertex`
# (Vertex AI in GOOGLE_CLOUD_PROJECT, Application Default Credentials).
GEMINI_BACKEND=api_key
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-3.8-flash) and GEMINI_FALLBACK_MODEL, tried once
# when the main model is overloaded (default gemini-3.7-flash; empty disables it).

# Speech-to-Text v2 / Text-to-Speech (and Vertex). Credentials come from Application Default
# Credentials: `gcloud auth application-default login`, or GOOGLE_APPLICATION_CREDENTIALS
# pointing to a service-account key file kept outside the repo.
GOOGLE_CLOUD_PROJECT=
# With docker compose, mount the credentials file into the app container with a git-ignored
# docker-compose.override.yml (see CLAUDE.md). Optional: GOOGLE_STT_ENDPOINTING=standard|short|
# supershort (default short): how much silence ends what the user said.
# Optional: GOOGLE_STT_DENOISE=false turns off the Speech-to-Text denoiser (on by default;
# it removes background noise, not other people's voices).
